<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tour Rouge</title>

  <script src="https://telegram.org/js/telegram-web-app.js"></script>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 20px;
      font-family: Arial, sans-serif;
      background: #111827;
      color: white;
      text-align: center;
    }

    .app {
      max-width: 500px;
      margin: 0 auto;
    }

    h1 {
      margin-top: 40px;
      font-size: 32px;
    }

    p {
      color: #aeb7c5;
      font-size: 17px;
    }

    button {
      width: 100%;
      padding: 16px;
      margin-top: 25px;
      border: 0;
      border-radius: 14px;
      background: #e63946;
      color: white;
      font-size: 18px;
      font-weight: bold;
    }
  </style>
</head>

<body>

  <div class="app">
    <h1>🎈 Tour Rouge</h1>

    <p>Bienvenue dans mon application Telegram.</p>

    <button onclick="bonjour()">Commencer</button>
  </div>

  <script>
    const tg = window.Telegram.WebApp;

    tg.ready();
    tg.expand();

    function bonjour() {
      tg.showAlert("Bienvenue sur Tour Rouge !");
    }
  </script>

</body>
</html>
